# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/template_app

# Server
PORT=8081
API_BASE_URL=http://localhost:8081
NODE_ENV=development

# JWT
APP_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
AUTHENTICATION_HASH_SALT=change-me-in-production

# Session cache
SESSION_CACHE_TTL_SECONDS=600
SESSION_CACHE_MAX_KEYS=50000
