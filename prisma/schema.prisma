generator client {
  provider               = "prisma-client"
  output                 = "./generated"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Permission {
  // Platform
  USER_VIEW           @map("user.view")
  USER_CREATE         @map("user.create")
  USER_UPDATE         @map("user.update")
  USER_DELETE         @map("user.delete")
  ROLE_VIEW           @map("role.view")
  ROLE_MANAGE         @map("role.manage")
  SESSION_MANAGE      @map("session.manage")
  AUDIT_LOG_VIEW      @map("audit_log.view")

  // Project / task / member
  PROJECT_CREATE      @map("project.create")
  PROJECT_DELETE      @map("project.delete")
  PROJECT_EDIT        @map("project.edit")
  TASK_CREATE         @map("task.create")
  TASK_EDIT_OWN       @map("task.edit_own")
  TASK_EDIT_ANY       @map("task.edit_any")
  TASK_DELETE         @map("task.delete")
  TASK_ASSIGN         @map("task.assign")
  TASK_CHANGE_STATUS  @map("task.change_status")
  MEMBER_INVITE       @map("member.invite")
  MEMBER_REMOVE       @map("member.remove")
  MEMBER_MANAGE_ROLES @map("member.manage_roles")
}

enum ProjectStatus {
  ACTIVE   @map("active")
  ARCHIVED @map("archived")
}

enum TaskType {
  SIMPLE    @map("simple")
  CHECKLIST @map("checklist")
}

enum TaskStatus {
  TODO        @map("todo")
  IN_PROGRESS @map("in_progress")
  DONE        @map("done")
}

enum TaskPriority {
  LOW    @map("low")
  MEDIUM @map("medium")
  HIGH   @map("high")
  URGENT @map("urgent")
}

// ---------------------------------------------------------------------------
// Auth & platform
// ---------------------------------------------------------------------------

model Role {
  id String @id @default(uuid()) @map("role_id") @db.Uuid

  code        String       @unique
  name        String
  description String?
  permissions Permission[]

  users          User[]
  projectMembers ProjectMember[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@map("roles")
}

model User {
  id String @id @default(uuid()) @map("user_id") @db.Uuid

  firstName     String  @map("first_name")
  lastName      String  @map("last_name")
  email         String  @unique
  password      String
  emailVerified Boolean @default(false) @map("email_verified")
  isActive      Boolean @default(true) @map("is_active")

  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])

  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]      @relation("AuditLogActor")
  ownedProjects  Project[]       @relation("ProjectOwner")
  projectMembers ProjectMember[]
  createdTasks   Task[]          @relation("TaskCreator")
  taskAssignees  TaskAssignee[]
  comments       Comment[]
  uploadedFiles  Attachment[]    @relation("AttachmentUploader")
  timeLogs       TimeLog[]
  notifications  Notification[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([roleId])
  @@map("users")
}

model RefreshToken {
  id String @id @default(uuid()) @map("refresh_token_id") @db.Uuid

  tokenHash         String   @unique @map("token_hash")
  expiresAt         DateTime @map("expires_at") @db.Timestamptz(6)
  replacedByTokenId String?  @map("replaced_by_token_id") @db.Uuid
  userAgent         String?  @map("user_agent")
  ipAddress         String?  @map("ip_address")
  revoked           Boolean  @default(false)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id String @id @default(uuid()) @map("audit_log_id") @db.Uuid

  action     String
  entityType String @map("entity_type")
  entityId   String @map("entity_id")
  before     Json?
  after      Json?
  metadata   Json?

  actorId String? @map("actor_id") @db.Uuid
  actor   User?   @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Projects & tasks (Phase 1)
// ---------------------------------------------------------------------------

model Project {
  id String @id @default(uuid()) @map("project_id") @db.Uuid

  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)

  ownerId String @map("owner_id") @db.Uuid
  owner   User   @relation("ProjectOwner", fields: [ownerId], references: [id])

  members ProjectMember[]
  tasks   Task[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([ownerId])
  @@index([status])
  @@map("projects")
}

model ProjectMember {
  id String @id @default(uuid()) @map("project_member_id") @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])

  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  @@unique([userId, projectId])
  @@index([projectId])
  @@index([roleId])
  @@map("project_members")
}

model Task {
  id String @id @default(uuid()) @map("task_id") @db.Uuid

  title       String
  description String?
  type        TaskType     @default(SIMPLE)
  weight      Int          @default(0)
  progress    Int          @default(0)
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?    @map("due_date") @db.Timestamptz(6)

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdById String @map("created_by_id") @db.Uuid
  createdBy   User   @relation("TaskCreator", fields: [createdById], references: [id])

  assignees    TaskAssignee[]
  subtasks     Subtask[]
  comments     Comment[]
  attachments  Attachment[]
  timeLogs     TimeLog[]
  dependencies TaskDependency[] @relation("DependentTask")
  blockedBy    TaskDependency[] @relation("BlockingTask")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([projectId])
  @@index([createdById])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

model TaskAssignee {
  id String @id @default(uuid()) @map("task_assignee_id") @db.Uuid

  taskId String @map("task_id") @db.Uuid
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  @@unique([taskId, userId])
  @@index([userId])
  @@map("task_assignees")
}

model Subtask {
  id String @id @default(uuid()) @map("subtask_id") @db.Uuid

  title      String
  weight     Int     @default(0)
  isComplete Boolean @default(false) @map("is_complete")

  taskId String @map("task_id") @db.Uuid
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([taskId])
  @@map("subtasks")
}

// ---------------------------------------------------------------------------
// Collaboration (Phase 2)
// ---------------------------------------------------------------------------

model Comment {
  id String @id @default(uuid()) @map("comment_id") @db.Uuid

  body String

  taskId String @map("task_id") @db.Uuid
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId String @map("author_id") @db.Uuid
  author   User   @relation(fields: [authorId], references: [id])

  attachments Attachment[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([taskId])
  @@index([authorId])
  @@map("comments")
}

model Attachment {
  id String @id @default(uuid()) @map("attachment_id") @db.Uuid

  fileUrl  String @map("file_url")
  fileName String @map("file_name")
  fileType String @map("file_type")
  size     Int

  taskId String? @map("task_id") @db.Uuid
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  commentId String?  @map("comment_id") @db.Uuid
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  uploadedById String @map("uploaded_by_id") @db.Uuid
  uploadedBy   User   @relation("AttachmentUploader", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([taskId])
  @@index([commentId])
  @@index([uploadedById])
  @@map("attachments")
}

model TaskDependency {
  id String @id @default(uuid()) @map("task_dependency_id") @db.Uuid

  taskId String @map("task_id") @db.Uuid
  task   Task   @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)

  dependsOnTaskId String @map("depends_on_task_id") @db.Uuid
  dependsOnTask   Task   @relation("BlockingTask", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
  @@map("task_dependencies")
}

model TimeLog {
  id String @id @default(uuid()) @map("time_log_id") @db.Uuid

  startedAt       DateTime  @map("started_at") @db.Timestamptz(6)
  endedAt         DateTime? @map("ended_at") @db.Timestamptz(6)
  durationMinutes Int?      @map("duration_minutes")
  note            String?

  taskId String @map("task_id") @db.Uuid
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([taskId])
  @@index([userId])
  @@map("time_logs")
}

model Notification {
  id String @id @default(uuid()) @map("notification_id") @db.Uuid

  type       String
  entityType String  @map("entity_type")
  entityId   String  @map("entity_id")
  message    String
  isRead     Boolean @default(false) @map("is_read")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}
