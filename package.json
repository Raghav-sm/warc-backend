{
  "name": "warc-backend",
  "version": "0.0.1",
  "description": "Auth + RBAC template backend",
  "scripts": {
    "tsc": "NODE_PATH=$NODE_PATH:./src node --stack-size=65536 ./node_modules/typescript/lib/tsc.js --traceResolution",
    "dev": "NODE_PATH=$NODE_PATH:./src ts-node-dev --respawn --transpile-only ./src/server.ts",
    "build": "NODE_PATH=$NODE_PATH:./src node --stack-size=65536 ./node_modules/typescript/lib/tsc.js",
    "prod": "NODE_PATH=$NODE_PATH:./src node --stack-size=65536 ./node_modules/typescript/lib/tsc.js && node ./build/src/server.js",
    "postinstall": "npx prisma generate --schema prisma",
    "format": "biome check --write --unsafe --max-diagnostics=1000 .",
    "test": "jest --verbose",
    "db:create": "tsx scripts/create-db.ts",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "yarn db:create && yarn db:migrate && yarn db:seed"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/graphql-depth-limit": "^1.1.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "body-parser": "^2.3.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "graphql": "^17.0.2",
    "graphql-date-scalars": "^0.2.0",
    "graphql-depth-limit": "^1.1.0",
    "graphql-middleware": "^6.1.35",
    "graphql-shield": "^7.6.5",
    "graphql-sse": "^2.6.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-type-json": "^0.3.2",
    "jsonwebtoken": "^9.0.3",
    "module-alias": "^2.3.4",
    "node-cache": "^5.1.2",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "prisma-extension-pagination": "^0.7.6",
    "short-unique-id": "^5.3.2",
    "tsx": "^4.23.0",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "_moduleAliases": {
    "prisma-client": "prisma/generated",
    "datasources": "src/datasources",
    "interfaces": "src/interfaces",
    "schema": "src/schema",
    "utils": "src/utils",
    "permissions": "src/permissions"
  },
  "license": "ISC"
}
